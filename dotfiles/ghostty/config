window-width = 160
window-height = 35

font-size = 13
font-family = Monaspace Argon
theme = Github Dark Default
background = #1d1d1d

# custom-shader = shaders/cursor_glide.glsl
# custom-shader = shaders/cursor_tail.glsl
custom-shader = shaders/cursor_sweep.glsl
# custom-shader = shaders/cursor_smear.glsl
# custom-shader = shaders/cursor_glide.glsl
# custom-shader = shaders/cursor_warp.glsl
# custom-shader = shaders/rectangle_boom_cursor.glsl
# custom-shader = shaders/ripple_cursor.glsl
# custom-shader = shaders/ripple_rectangle_cursor.glsl
# custom-shader = shaders/sonic_boom_cursor.glsl

cursor-opacity=1
cursor-text = #1d1d1d
cursor-color = #22c55e
cursor-style = bar
cursor-style-blink = false
shell-integration-features = no-cursor

title = " "
# macos-titlebar-style=tabs
macos-window-buttons = hidden
macos-titlebar-proxy-icon = hidden
adjust-cell-height = 10%
custom-shader-animation = true

